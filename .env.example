# Together AI API key — required for all LLM calls
# Get yours at: https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=your_together_api_key_here

# Finnhub API key — free tier includes earnings call transcripts
# Get a free key at: https://finnhub.io/
# This is the recommended transcript source (free tier, 60 calls/min)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Financial Modeling Prep API key — requires Ultimate plan ($149/mo) for transcripts
# Free tier does NOT include transcripts. Only needed as an alternative to Finnhub.
# Not needed if you use Finnhub or always pass --file with a local transcript
FMP_API_KEY=your_fmp_api_key_here
