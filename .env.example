# HuggingFace API token — required for all LLM calls
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Financial Modeling Prep API key — required for --ticker transcript fetching
# Free tier at: https://financialmodelingprep.com/developer/docs/
# Not needed if you always pass --transcript with a local file
FMP_API_KEY=your_fmp_api_key_here
